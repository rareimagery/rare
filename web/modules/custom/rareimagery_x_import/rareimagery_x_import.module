<?php

/**
 * @file
 * RareImagery X Import module.
 */

/**
 * Implements hook_user_login().
 */
function rareimagery_x_import_user_login(\Drupal\Core\Session\AccountInterface $account) {
  // Skip if no X handle.
  if (!$account->hasField('field_x_handle') || !$account->field_x_handle->value) {
    return;
  }
  
  $x_handle = $account->field_x_handle->value;
  
  $x_api = \Drupal::service('rareimagery_x_import.x_api');
  $x_user = $x_api->getUserProfile($x_handle);
  
  if (empty($x_user)) return;
  
  // Load/create profile.
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $profiles = $storage->loadByProperties(['type' => 'creator_x_profile', 'field_x_username' => $x_handle]);
  $profile = reset($profiles);
  if (!$profile) {
    $profile = $storage->create([
      'type' => 'creator_x_profile',
      'title' => $x_user['name'] . ' - X Profile',
      'field_x_username' => $x_handle,
    ]);
  }
  
  // Update core fields.
  $profile->set('field_bio_description', [
    'value' => $x_user['description'] ?? '',
    'format' => 'basic_html',
  ]);
  $profile->set('field_follower_count', $x_user['public_metrics']['followers_count'] ?? 0);
  
  // TODO: PFP/banner download, top posts/followers via $x_api.
  
  $profile->save();
}
