# Copy this to .env and fill in real values
# cp .env.example .env

# Postgres
POSTGRES_DB=rare_drupal
POSTGRES_USER=rare_user
POSTGRES_PASSWORD=CHANGE_ME_SuperStrongPassword123

# Ports
# Production should expose Drupal on 80.
# For local development, override DRUPAL_PORT to 8080 if port 80 is unavailable.
POSTGRES_PORT=5432
DRUPAL_PORT=80

# Grok / X AI
XAI_API_KEY=your_xai_key_from_console.x.ai

# Comma-separated X usernames or X IDs who should get free subscription access
# Example: FREE_SUBSCRIPTION_ALLOWLIST=rarehelper1,123456789012345678
FREE_SUBSCRIPTION_ALLOWLIST=

# X / Twitter API
# Backend / Drupal integrations may still use consumer credentials.
X_CONSUMER_KEY=your_x_consumer_key
X_CONSUMER_SECRET=your_x_consumer_secret

# Next.js / NextAuth X OAuth 2.0 login
X_CLIENT_ID=your_x_oauth_client_id
X_CLIENT_SECRET=your_x_oauth_client_secret
X_API_BEARER_TOKEN=your_x_app_bearer_token
RAREPROJECT_X_USERNAME=rareproject
