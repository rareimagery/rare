# Copy this to .env and fill in real values
# cp .env.example .env

# Postgres
POSTGRES_DB=rare_drupal
POSTGRES_USER=rare_user
POSTGRES_PASSWORD=CHANGE_ME_SuperStrongPassword123

# Ports (local dev uses 5433/8080, production uses 5432/8080)
POSTGRES_PORT=5432
DRUPAL_PORT=8080

# Grok / X AI
XAI_API_KEY=your_xai_key_from_console.x.ai

# X / Twitter API
# Option 1: Bearer Token from X Developer Portal (recommended, simplest)
X_BEARER_TOKEN=your_x_bearer_token_from_developer_portal
# Option 2: OAuth2 client credentials (used if Bearer Token is not set)
X_CONSUMER_KEY=your_x_consumer_key
X_CONSUMER_SECRET=your_x_consumer_secret

# Stripe (required for store subscriptions + payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Printful (required for POD product sync + fulfillment)
PRINTFUL_API_KEY=your_printful_api_key
PRINTFUL_WEBHOOK_SECRET=your_printful_webhook_secret
